# Server-side section switches. Restart the dev server after changing.
OANRO_PRODUCTS=true
OANRO_SERVICES=true
OANRO_PARTNERS=true
OANRO_FEATURES=true
OANRO_INTRO=false
# Public business contact details. These values are safe to display to customers.
OANRO_CONTACT_EMAIL=oanro.saas@gmail.com
OANRO_MESSENGER_URL=https://www.facebook.com/profile.php?id=61594439084842
# Digits only with country code, for example 8801XXXXXXXXX. Leave blank until ready.
OANRO_WHATSAPP_NUMBER=

# M2: server-only. Leave disabled until database, email and OAuth are tested.
OANRO_AUTH_ENABLED=false
DATABASE_URL=
BETTER_AUTH_URL=http://localhost:3000
# Generate locally: openssl rand -base64 48
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google callback: <BETTER_AUTH_URL>/api/auth/callback/google
# SMTP provider is your choice. Never commit credentials.
SMTP_URL=
AUTH_EMAIL_FROM=

# SEO / marketing (public values). Set OANRO_SITE_URL=https://oanro.com once the domain is connected.
OANRO_SITE_URL=
# true only when real products and prices are on sale: enables Product price/stock data for Google.
OANRO_STORE_LIVE=false
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX. Leave blank until ready.
NEXT_PUBLIC_GA_ID=

# ---- OANRO Assistant (enable from Admin → JUNO bot after the database migration) ----
# Server-only secrets. Never prefix these with NEXT_PUBLIC_ and never commit real values.
# Optional emergency stop: false disables the bot regardless of the admin switch.
# Leave unset for normal admin control.
# ASSISTANT_ENABLED=false
# Primary AI + speech-to-text: free Groq key from https://console.groq.com/keys
GROQ_API_KEY=
# Backup AI: free Cloudflare Workers AI. Account id (32 hex characters) + an API token limited to "Workers AI".
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Order of providers for chat (comma separated). Unknown ids and Gemini are ignored.
ASSISTANT_PROVIDER_ORDER=groq,cloudflare
# Optional: pick another allow-listed model (see src/lib/assistant/config.ts). Anything else is ignored.
# ASSISTANT_GROQ_MODEL=openai/gpt-oss-120b
# ASSISTANT_CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct
# ASSISTANT_WHISPER_MODEL=whisper-large-v3-turbo
# Our own daily caps (kept below the free limits you see in each provider's console; 0 turns a provider off).
# ASSISTANT_GROQ_DAILY_REQUESTS=800
# ASSISTANT_GROQ_DAILY_TOKENS=90000
# ASSISTANT_CLOUDFLARE_DAILY_REQUESTS=150
# ASSISTANT_TRANSCRIBE_DAILY_REQUESTS=1500
# ASSISTANT_AUDIO_DAILY_SECONDS=20000
# Per-visitor limits: 20 messages per 10 minutes by default.
# ASSISTANT_CHAT_PER_WINDOW=20
# ASSISTANT_CHAT_WINDOW_MINUTES=10
# Disabled alternatives: stay off until you have verified their terms. Setting a key alone does nothing.
# CEREBRAS_API_KEY=
# ASSISTANT_APPROVE_CEREBRAS=false
# OPENROUTER_API_KEY=
# ASSISTANT_APPROVE_OPENROUTER=false
# Optional free bot check (Cloudflare Turnstile). Both values together switch it on.
# TURNSTILE_SECRET_KEY=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Protects the daily cleanup job (/api/cron/assistant-cleanup): generate with  openssl rand -base64 32
CRON_SECRET=
