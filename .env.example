# Server-side section switches. Restart the dev server after changing.
OANRO_PRODUCTS=true
OANRO_SERVICES=true
OANRO_PARTNERS=true
OANRO_FEATURES=true
OANRO_INTRO=true
# Public business contact details. These values are safe to display to customers.
OANRO_CONTACT_EMAIL=oanro.saas@gmail.com
OANRO_MESSENGER_URL=https://www.facebook.com/profile.php?id=61594439084842
# Digits only with country code, for example 8801XXXXXXXXX. Leave blank until ready.
OANRO_WHATSAPP_NUMBER=

# M2: server-only. Leave disabled until database, email and OAuth are tested.
OANRO_AUTH_ENABLED=false
DATABASE_URL=
BETTER_AUTH_URL=http://localhost:3000
# Generate locally: openssl rand -base64 48
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google callback: <BETTER_AUTH_URL>/api/auth/callback/google
# SMTP provider is your choice. Never commit credentials.
SMTP_URL=
AUTH_EMAIL_FROM=
